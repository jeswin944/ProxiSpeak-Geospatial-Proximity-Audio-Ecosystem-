# ProxiSpeak Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with real secrets to version control.

# HTTP & WebSocket Server Port
PORT=3000

# Permitted Client Origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Replace <username> and <password> with your Atlas cluster database user credentials
# Example: mongodb+srv://my_db_user:my_secret_pass@cluster0.mongodb.net/proxispeak?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://proxispeak_user:proxispeak_user@cluster0.15pqtub.mongodb.net/proxispeak?retryWrites=true&w=majority
