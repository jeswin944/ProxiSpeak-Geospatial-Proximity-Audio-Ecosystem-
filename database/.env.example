# ProxiSpeak Database Service Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with real secrets to version control.

# Service Port
PORT=3000

# MongoDB Atlas Connection URI
# Replace <username> and <password> with your Atlas cluster database user credentials
# Or for local development: mongodb://127.0.0.1:27017/proxispeak
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/proxispeak?retryWrites=true&w=majority
